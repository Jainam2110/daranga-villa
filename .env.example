# =============================================================================
# DARANGA VILLA — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Fill in values in your Vercel Dashboard / local .env.local file.
# Never commit actual secret keys or values to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas) [SERVER ONLY]
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION (JWT & Admin User) [SERVER ONLY]
# -----------------------------------------------------------------------------
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# -----------------------------------------------------------------------------
# 3. CLOUDINARY (Media & Villa Image Storage) [SERVER ONLY]
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# 4. FIREBASE CLIENT CONFIGURATION (Customer Auth) [PUBLIC]
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# 5. FIREBASE ADMIN SDK (Customer ID Token Verification) [SERVER ONLY]
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY (Test / Live Mode) [SERVER ONLY]
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAILS (Resend / Custom SMTP) [SERVER ONLY - OPTIONAL]
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# -----------------------------------------------------------------------------
# 8. BOOKING ENGINE & CRON SCHEDULE [SERVER ONLY - OPTIONAL]
# -----------------------------------------------------------------------------
PAYMENT_HOLD_MINUTES=
CRON_SECRET=

# -----------------------------------------------------------------------------
# 9. GOOGLE MAPS & PLACES API [PUBLIC / CLIENT]
# -----------------------------------------------------------------------------
# Required Google Cloud APIs to enable in Google Cloud Console:
# 1. Maps JavaScript API (For interactive map & draggable pin)
# 2. Places API / Places API (New) (For location & place search autocomplete)
# 3. Geocoding API (For reverse geocoding on marker drag & address resolve)
# Security Recommendation: Restrict key by HTTP Referrer in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# 10. PUBLIC SITE CONFIGURATION [PUBLIC]
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
# WhatsApp Concierge phone number with country code (e.g., +919876543210 or 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

